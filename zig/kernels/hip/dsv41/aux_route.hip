/* The main model's MoE routing for gfx1151, replacing the Triton _route_parts (tri_kernels.py) of the round and of
 * prompt chunks up to 16 rows, bit for bit. ADAPTER.md section 6: group "aux", one by-value struct each
 * (tf_ds_aux_route_args, tf_ds_aux_route_score_args, abi.h), registered in registry.json.
 *
 * What it computes, for each row r of S fp32 [rows, kc, 384] (rowmm_parts' chunk sums of the router logits):
 *   lg[e]  = ((0 + S[r, 0, e]) + S[r, 1, e]) + ... + S[r, kc - 1, e]       plain fp32 adds, chunk 0 first, from zero
 *   sc[e]  = sqrt_softplus(lg[e])                                          tri_kernels._sqrt_softplus, operation for
 *            operation as the kit's _route_parts object executes it (out/fusion-20261121/T2-score-asm.md: the
 *            instruction DAG of route_score() below equals the deployed object's, slice for slice)
 *   sel[e] = sc[e] + bias[e]
 *   picks  = the topk largest sel under the strict order "greater sel first, equal sel lower index first" (== does
 *            not tell -0 from +0, a NaN sel is never picked): Triton's topk rounds of "max (maxnum: a NaN is never
 *            the maximum), lowest index among equals, mask to -inf" pick exactly these whenever at least topk sel are
 *            above -inf. A thread counts the elements that beat its own (its rank); rank < topk is pick[rank].
 *            Rows with fewer than topk sel above -inf (a NaN or -inf bias, NaN logits) run Triton's loop literally
 *            over its 512 padded lanes (pads: lg 0, sel -inf, indices 384..511), so their duplicate and pad picks
 *            and weights are Triton's.
 *   v_k = sc[pick_k] + 0; tot = (((0 + v_0) + v_1) + ...); wts_k = v_k / (tot + 1e-20) * scale, slots topk..slots-1
 *            hold shared_id and 1.0.
 * Every operation is an fp32 add, multiply, divide (correctly rounded, -fno-fast-math) or the fma written out; the
 * file is compiled with -ffp-contract=off (hip_flags), so no other contraction exists.
 * Work: a row a workgroup, a thread an expert (block 384, 12 waves); the shape (kc 20, 384 experts) is the main
 * model's, tri_norm.route checks it.
 *
 * tf_ds_aux_route_score: out[i] = route_score(in[i]) over n values (grid-stride, block 256): the same helper, for the
 * exhaustive comparison against the Triton _t_score oracle (test only; not in the kit's required lists). */
#include <hip/hip_runtime.h>
#include <stdint.h>
#include "abi.h"

#define TF_GLOBAL __attribute__((address_space(1)))

namespace {
template <class T> __device__ inline TF_GLOBAL T* gp(uint64_t a) { return (TF_GLOBAL T*)a; }

constexpr int kNe = 384;      // experts: one thread each
constexpr int kKc = 20;       // chunk sums a row (5120 / 256)
constexpr int kNb = 512;      // Triton's padded lanes (pow2(384))
constexpr int kWaves = kNe / 32;
constexpr int kMaxK = 8;      // topk and slots at most

// _exp_rr (tri_kernels.py): e^x by Cody-Waite reduction, a degree-7 Taylor polynomial and ldexp. The kit's object:
// the clamp as med3(x, -150, 100) with a NaN x kept; x * log2e + 0.5 contracted into one fma (Triton's fp fusion);
// every tl.fma an fma; the constants the fp32 values Triton passes (hex literals: no decimal rounding question).
__device__ inline float exp_rr(float x) {
    const float c = (x != x) ? x : __builtin_amdgcn_fmed3f(x, -150.0f, 100.0f);
    const float n = __builtin_floorf(__builtin_fmaf(c, 0x1.715476p+0f, 0.5f));   // log2 e
    float r = __builtin_fmaf(n, -0x1.62e400p-1f, c);                               // -0.693145751953125
    r = __builtin_fmaf(n, -0x1.7f7d1cp-20f, r);                                    // -1.4286068203094172e-06
    float p = __builtin_fmaf(r, 0x1.a01a02p-13f, 0x1.6c16c2p-10f);                 // 1/5040, 1/720
    p = __builtin_fmaf(p, r, 0x1.111112p-7f);                                      // 1/120
    p = __builtin_fmaf(p, r, 0x1.555556p-5f);                                      // 1/24
    p = __builtin_fmaf(p, r, 0x1.555556p-3f);                                      // 1/6
    p = __builtin_fmaf(p, r, 0.5f);
    p = __builtin_fmaf(p, r, 1.0f);
    p = __builtin_fmaf(p, r, 1.0f);
    return __builtin_ldexpf(p, (int)n);
}

// libdevice.log1p (__ocml_log1p_f32) as the kit's _route_parts object executes it: the Triton 3.8 wheel's own device
// library, inlined and lowered by its LLVM. hipcc's ROCm device library expands log1pf differently (the exponent by
// v_frexp_exp_i32_f32, another split of ln 2), so the kit's expansion is written out here node for node: t<N> is node
// %N of the deployed object's score DAG (out/fusion-20261121/score/dag/, dataflow.py; generated by gen_log1p.py) and
// x is node %34, _exp_rr(lg). The empty asm on t72 and t88 (products the code negates) keeps LLVM from rewriting
// -(a * b) as a * -b, which the kit's object does not do. It is log(1 + x) in double-float arithmetic (two-sum of 1 + x, the mantissa reduced to
// [2/3, 4/3) with its exponent e, log of the reduced pair by an atanh series, plus e ln 2 in three parts), then the
// specials: |x| < 2^-24 -> x, x == -1 -> -inf, x < -1 -> NaN, x == +inf -> +inf.
__device__ inline float log1p_kit(float x) {
    const float t35 = __builtin_fabsf(x);
    const bool t36 = t35 < 0x1p-24f;
    const bool t37 = x != -0x1p+0f;
    const bool t38 = !(x < -0x1p+0f);
    const bool t39 = x != __builtin_inff();
    const float t40 = x + 0x1p+0f;
    const int t45 = __builtin_amdgcn_frexp_exp((double)t40);
    const float t46 = __builtin_amdgcn_frexp_mantf(t40);
    const bool t47 = t46 < 0x1.5555560000000p-1f;
    const int t48 = t45 - (int)t47;
    const int t49 = 0 - t48;
    const float t50 = __builtin_ldexpf(t40, t49);
    const float t51 = t50 + 0x1p+0f;
    const float t52 = t51 + -0x1p+0f;
    const float t53 = t50 - t52;
    const float t54 = t40 + -0x1p+0f;
    const float t55 = t54 - t40;
    const float t56 = t55 + 0x1p+0f;
    const float t57 = x - t54;
    const float t58 = t56 + t57;
    const float t59 = __builtin_ldexpf(t58, t49);
    const float t60 = t53 + t59;
    const float t61 = t51 + t60;
    const float t62 = -t61;
    const float t63 = t50 + -0x1p+0f;
    const float t64 = t63 + 0x1p+0f;
    const float t65 = t50 - t64;
    const float t66 = t65 + t59;
    const float t67 = t66 + t63;
    const float t68 = __builtin_amdgcn_rcpf(t61);
    const float t69 = t67 * t68;
    const float t70 = t61 - t51;
    const float t71 = t60 - t70;
    float t72 = t61 * t69;
    asm("" : "+v"(t72));
    const float t73 = -t72;
    const float t74 = __builtin_fmaf(t61, t69, t73);
    const float t75 = __builtin_fmaf(t69, t71, t74);
    const float t76 = __builtin_fmaf(t61, t69, t75);
    const float t77 = __builtin_fmaf(t62, t69, t76);
    const float t78 = t77 - t75;
    const float t79 = t67 - t63;
    const float t80 = t66 - t79;
    const float t81 = t67 - t76;
    const float t82 = t67 - t81;
    const float t83 = t82 - t76;
    const float t84 = t80 + t83;
    const float t85 = t78 + t84;
    const float t86 = t85 + t81;
    const float t87 = t86 * t68;
    float t88 = t61 * t87;
    asm("" : "+v"(t88));
    const float t89 = -t88;
    const float t90 = __builtin_fmaf(t61, t87, t89);
    const float t91 = __builtin_fmaf(t87, t71, t90);
    const float t92 = __builtin_fmaf(t61, t87, t91);
    const float t93 = __builtin_fmaf(t62, t87, t92);
    const float t94 = t93 - t91;
    const float t95 = t86 - t92;
    const float t96 = t86 - t95;
    const float t97 = t96 - t92;
    const float t98 = t81 - t86;
    const float t99 = t98 + t85;
    const float t100 = t97 + t99;
    const float t101 = t94 + t100;
    const float t102 = t101 + t95;
    const float t103 = -t67;
    const float t104 = __builtin_fmaf(t67, t68, t87);
    const float t105 = __builtin_fmaf(t103, t68, t104);
    const float t106 = -t105;
    const float t107 = __builtin_fmaf(t86, t68, t106);
    const float t108 = __builtin_fmaf(t102, t68, t107);
    const float t109 = t104 + t108;
    const float t110 = t109 - t104;
    const float t111 = t108 - t110;
    const float t112 = t109 * t109;
    const float t113 = __builtin_fmaf(t112, 0x1.36db580000000p-2f, 0x1.992b460000000p-2f);
    const float t114 = __builtin_fmaf(t113, t112, 0x1.5555b40000000p-1f);
    const float t115 = t112 * t109;
    const float t116 = t114 * t115;
    const float t117 = __builtin_fmaf(t109, 0x1p+1f, t116);
    const float t118 = __builtin_fmaf(t109, -0x1p+1f, t117);
    const float t119 = -t118;
    const float t120 = __builtin_fmaf(t114, t115, t119);
    const float t121 = __builtin_fmaf(t111, 0x1p+1f, t120);
    const float t122 = t117 + t121;
    const float t123 = t122 - t117;
    const float t124 = t121 - t123;
    const float t125 = (float)t48;
    const float t126 = t125 * -0x1.62e4300000000p-1f;
    const float t127 = __builtin_fmaf(t125, 0x1.62e4300000000p-1f, t126);
    const float t128 = __builtin_fmaf(t125, -0x1.05c6100000000p-29f, t127);
    const float t129 = __builtin_fmaf(t125, 0x1.62e4300000000p-1f, t128);
    const float t130 = __builtin_fmaf(t125, -0x1.62e4300000000p-1f, t129);
    const float t131 = t128 - t130;
    const float t132 = t131 + t124;
    const float t133 = t132 - t131;
    const float t134 = t124 - t133;
    const float t135 = t132 - t133;
    const float t136 = t131 - t135;
    const float t137 = t134 + t136;
    const float t138 = t129 + t122;
    const float t139 = t138 - t129;
    const float t140 = t138 - t139;
    const float t141 = t129 - t140;
    const float t142 = t122 - t139;
    const float t143 = t141 + t142;
    const float t144 = t132 + t143;
    const float t145 = t144 + t138;
    const float t146 = t145 - t138;
    const float t147 = t144 - t146;
    const float t148 = t137 + t147;
    const float t149 = t148 + t145;
    const float t150 = t39 ? t149 : __builtin_inff();
    const float t151 = t38 ? t150 : __builtin_nanf("");
    const float t152 = t37 ? t151 : -__builtin_inff();
    const float t153 = t36 ? x : t152;
    return t153;
}

// _sqrt_softplus (tri_kernels.py): both arms evaluated, then selected, as tl.where does. log1p is the device
// library's log1p as the kit's object has it (log1p_kit); __builtin_sqrtf the correctly rounded llvm.sqrt.f32
// (tl.sqrt_rn), whose expansion (scale below 2^-96, v_sqrt_f32, the +-1 ulp fix by two fmas) equals the object's.
__device__ inline float route_score(float lg) {
    const float l1 = log1p_kit(exp_rr(lg));
    const float sp = lg > 20.0f ? lg : l1;
    const float lo = exp_rr(0.5f * lg);
    const float hi = __builtin_sqrtf(sp);
    return lg < -16.0f ? lo : hi;
}

// a beats b in the picks' order: greater sel first, equal sel lower index first (NaN never beats, never is beaten)
__device__ inline bool beats(float a, int ia, float b, int ib) { return a > b || (a == b && ia < ib); }
}  // namespace

extern "C" __global__ __launch_bounds__(kNe) void tf_ds_aux_route_pick_ne384(tf_ds_aux_route_args a) {
    __shared__ float s_sel[kNe], s_sc[kNe];
    __shared__ float s_wv[kWaves];
    __shared__ int s_wi[kWaves];
    __shared__ int s_pick[kMaxK];
    const int r = blockIdx.x, e = threadIdx.x, lane = e & 31, wave = e >> 5;
    const TF_GLOBAL float* S = gp<const float>(a.s) + (size_t)r * kKc * kNe;
    float lg = 0.0f;
#pragma unroll
    for (int t = 0; t < kKc; ++t) lg += S[t * kNe + e];
    const float sc = route_score(lg);
    // the pads' score (lg +0, a runtime value: never constant-folded), computed here in the same straight-line code
    // as sc (the volatile use keeps it from being sunk into the degenerate branch, so its instruction slice is one
    // block, as dataflow.py requires); only a degenerate row reads it
    float z = 0.0f;
    asm volatile("" : "+v"(z));
    const float sc_pad = route_score(z);
    asm volatile("" ::"v"(sc_pad));
    const float sel = sc + gp<const float>(a.bias)[e];
    s_sel[e] = sel;
    s_sc[e] = sc;
    const bool valid = sel > -__builtin_inff();                  // NaN: not valid
    // the wave's best valid element (an invalid one counts as -inf: it never beats a valid one)
    float bv = valid ? sel : -__builtin_inff();
    int bi = e;
#pragma unroll
    for (int o = 16; o > 0; o >>= 1) {
        const float ov = __shfl_xor(bv, o, 32);
        const int oi = __shfl_xor(bi, o, 32);
        if (beats(ov, oi, bv, bi)) bv = ov, bi = oi;
    }
    if (lane == 0) s_wv[wave] = bv, s_wi[wave] = bi;
    const int n_valid = __syncthreads_count(valid);              // also the barrier for s_sel, s_sc, s_wv, s_wi
    const int topk = a.topk, slots = a.slots;
    TF_GLOBAL int* pick = gp<int>(a.pick) + (size_t)r * slots;
    TF_GLOBAL float* wts = gp<float>(a.wts) + (size_t)r * slots;
    if (n_valid >= topk) {
        if (valid) {
            // topk wave maxima (distinct elements) that beat this one: it is not among the topk
            int above = 0;
#pragma unroll
            for (int w = 0; w < kWaves; ++w) above += beats(s_wv[w], s_wi[w], sel, e);
            if (above < topk) {
                int rank = 0;
                for (int j = 0; j < kNe; ++j) rank += beats(s_sel[j], j, sel, e);
                if (rank < topk) s_pick[rank] = e;
            }
        }
        __syncthreads();
        if (e == 0) {
            float v[kMaxK];
            float tot = 0.0f;
            for (int k = 0; k < topk; ++k) {
                v[k] = s_sc[s_pick[k]] + 0.0f;
                tot += v[k];
            }
            const float den = tot + 0x1.79ca10p-67f;             // 1e-20 as fp32 (0x1e3ce508)
            for (int s = 0; s < slots; ++s) {
                pick[s] = s < topk ? s_pick[s] : a.shared_id;
                wts[s] = s < topk ? v[s] / den * a.scale : 1.0f;
            }
        }
        return;
    }
    // degenerate row: Triton's loop over its 512 lanes, literally (thread 0)
    if (e != 0) return;
    int pk[kMaxK];
    float v[kMaxK];
    float tot = 0.0f;
    for (int k = 0; k < topk; ++k) {
        float best = -__builtin_inff();                          // the pads' sel: the maximum is at least -inf
        for (int j = 0; j < kNe; ++j) best = __builtin_fmaxf(best, s_sel[j]);   // maxnum: a NaN never wins
        int idx = kNb;
        for (int j = 0; j < kNe; ++j)
            if (s_sel[j] == best) {
                idx = j;
                break;
            }
        if (idx == kNb) idx = kNe;                                // best == -inf, no element: the first pad (sel -inf)
        // a pad's sel stays -inf after masking, so a pad, once reached, is picked again in every later round
        pk[k] = idx;
        v[k] = (idx < kNe ? s_sc[idx] : sc_pad) + 0.0f;
        tot += v[k];
        if (idx < kNe) s_sel[idx] = -__builtin_inff();
    }
    const float den = tot + 0x1.79ca10p-67f;
    for (int s = 0; s < slots; ++s) {
        pick[s] = s < topk ? pk[s] : a.shared_id;
        wts[s] = s < topk ? v[s] / den * a.scale : 1.0f;
    }
}

extern "C" __global__ __launch_bounds__(256) void tf_ds_aux_route_score(tf_ds_aux_route_score_args a) {
    const TF_GLOBAL float* in = gp<const float>(a.in);
    TF_GLOBAL float* out = gp<float>(a.out);
    for (int64_t i = (int64_t)blockIdx.x * 256 + threadIdx.x; i < a.n; i += (int64_t)gridDim.x * 256)
        out[i] = route_score(in[i]);
}
